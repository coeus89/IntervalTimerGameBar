<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IntervalTimerOverlay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IntervalTimerOverlay"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Interval Timer">

    <!-- Root.Background is switched between Transparent and a solid panel at runtime -->
    <Grid x:Name="Root" Background="#EE1B1B1F">
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Interval Timer">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayToggleItem" Text="Start" Click="OnTrayToggle" />
                    <MenuFlyoutItem Text="Show / hide window" Click="OnTrayShowHide" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnTrayExit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid x:Name="ContentGrid" Padding="10" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / drag strip -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="INTERVAL TIMER" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.6" VerticalAlignment="Center" />
                <ToggleButton x:Name="SettingsToggle" Grid.Column="1" Padding="6,2" FontSize="12"
                              Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                              Checked="OnSettingsToggled" Unchecked="OnSettingsToggled"
                              ToolTipService.ToolTip="Settings" />
                <Button x:Name="MinimizeButton" Grid.Column="2" Padding="6,2" FontSize="12"
                        Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="OnHideToTray"
                        ToolTipService.ToolTip="Hide to tray (keeps running)" />
                <Button x:Name="CloseButton" Grid.Column="3" Padding="6,2" FontSize="12"
                        Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="OnClose"
                        ToolTipService.ToolTip="Close (quit)" />
            </Grid>

            <!-- Countdown -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock x:Name="CountdownText" Text="01:00" FontSize="34" FontWeight="SemiBold"
                           FontFamily="Consolas" VerticalAlignment="Center" />
                <Button x:Name="StartStopButton" Content="Start" MinWidth="72" VerticalAlignment="Center"
                        Click="OnStartStop" />
            </StackPanel>

            <!-- Settings panel; scrolls because the content can exceed the window's max height -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" MaxHeight="320"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Padding="0,0,12,0">
                    <NumberBox x:Name="IntervalBox" Header="Beep every (seconds)"
                               Minimum="1" Maximum="86400" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Inline" ValueChanged="OnIntervalChanged" />
                    <ComboBox x:Name="SoundBox" Header="Sound" HorizontalAlignment="Stretch"
                              SelectionChanged="OnSoundChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImportSoundButton" Grid.Column="0" Content="Import sound file..."
                                HorizontalAlignment="Stretch" Click="OnImportSound" />
                        <Button x:Name="DeleteSoundButton" Grid.Column="1" Content="Remove" IsEnabled="False"
                                Click="OnDeleteSound" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Grid.Column="0" Header="Volume" Minimum="0" Maximum="100"
                                ValueChanged="OnVolumeChanged" />
                        <Button Grid.Column="1" Content="Test" VerticalAlignment="Bottom" Click="OnTestSound" />
                    </Grid>

                    <!-- Announcement (sound vs. speech on each interval boundary) -->
                    <ComboBox x:Name="AnnouncementModeBox" Header="Announcement" HorizontalAlignment="Stretch"
                              SelectionChanged="OnAnnouncementModeChanged" />
                    <ComboBox x:Name="VoiceBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnVoiceChanged" />
                    <TextBox x:Name="SpeechTextBox" LostFocus="OnSpeechTextCommitted"
                             TextChanged="OnSpeechTextChanged" />
                    <TextBlock Text="Tokens: {interval}, {count}, {time}" FontSize="11" Opacity="0.6" />
                    <Slider x:Name="SpeechRateSlider" Header="Speaking rate" Minimum="50" Maximum="200" Value="100"
                            ValueChanged="OnSpeechRateChanged" />
                    <Button Content="Test announcement" Click="OnTestAnnouncement" />

                    <CheckBox x:Name="TransparentCheck" Content="Transparent background"
                              Checked="OnTransparentChanged" Unchecked="OnTransparentChanged" />
                    <CheckBox x:Name="AutoStartCheck" Content="Start timer when app opens"
                              Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
